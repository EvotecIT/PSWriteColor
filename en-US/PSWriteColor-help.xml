    <command:details>
      <command:name>Write-Color</command:name>
      <command:verb>Write</command:verb>
      <command:noun>Color</command:noun>
      <maml:description>
        <maml:para>Write-Color is a wrapper around Write-Host delivering a lot of additional features for easier color options.</maml:para>
      </maml:description>
    </command:details>
    <maml:description>
      <maml:para>Write-Color is a wrapper around Write-Host delivering a lot of additional features for easier color options.</maml:para>
      <maml:para>It provides:&#xD;
- Easy manipulation of colors,&#xD;
- Logging output to file (log)&#xD;
- Nice formatting options out of the box.&#xD;
- Ability to use aliases for parameters</maml:para>
    </maml:description>
