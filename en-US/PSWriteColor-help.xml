        <maml:name>LinesBefore</maml:name>
        <maml:description>
          <maml:para>Number of empty lines before text. Default is 0.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">Int32</command:parameterValue>
        <dev:type>
          <maml:name>Int32</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>0</dev:defaultValue>
      </command:parameter>
      <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="False" position="7" aliases="L">
        <maml:name>LogFile</maml:name>
        <maml:description>
          <maml:para>Literal path to the log file. If not specified no log file will be created.&#xD;
Appends joined text with a newline, regardless of NoNewLine. Parent directories must already exist.&#xD;
File-write failures produce warnings after up to LogRetry attempts.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">String</command:parameterValue>
        <dev:type>
          <maml:name>String</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>None</dev:defaultValue>
      </command:parameter>
      <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="False" position="10" aliases="none">
        <maml:name>LogRetry</maml:name>
        <maml:description>
          <maml:para>Maximum number of file-write attempts, including the first attempt. Must be at least 1. Default is 2.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">Int32</command:parameterValue>
        <dev:type>
          <maml:name>Int32</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>2</dev:defaultValue>
      </command:parameter>
      <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="False" position="9" aliases="LogTimeStamp">
        <maml:name>LogTime</maml:name>
        <maml:description>
          <maml:para>If set to $true it will add time to log file. Default is $true.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">Boolean</command:parameterValue>
        <dev:type>
          <maml:name>Boolean</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>True</dev:defaultValue>
      </command:parameter>
      <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="False" position="named" aliases="HideConsole">
        <maml:name>NoConsoleOutput</maml:name>
        <maml:description>
          <maml:para>Switch to not output to console. Default all output goes to console.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">SwitchParameter</command:parameterValue>
        <dev:type>
          <maml:name>SwitchParameter</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>False</dev:defaultValue>
      </command:parameter>
      <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="False" position="named" aliases="none">
        <maml:name>NoNewLine</maml:name>
        <maml:description>
          <maml:para>Switch to not add new line at the end of the output. Default is not set.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">SwitchParameter</command:parameterValue>
        <dev:type>
          <maml:name>SwitchParameter</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>False</dev:defaultValue>
      </command:parameter>
      <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="False" position="13" aliases="PC">
        <maml:name>PadCenter</maml:name>
        <maml:description>
          <maml:para>Minimum combined text width, with padding on both sides. An odd extra character goes on the right.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">Int32</command:parameterValue>
        <dev:type>
          <maml:name>Int32</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>0</dev:defaultValue>
      </command:parameter>
      <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="False" position="15" aliases="PadChar">
        <maml:name>PadCharacter</maml:name>
        <maml:description>
          <maml:para>Single character used for padding. Default is a space.&#xD;
Padding uses the first foreground/background colors. With padding enabled, LinesBefore and LinesAfter&#xD;
also fill the requested width with this character and these colors.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">Char</command:parameterValue>
        <dev:type>
          <maml:name>Char</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>None</dev:defaultValue>
      </command:parameter>
      <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="False" position="12" aliases="PL">
        <maml:name>PadLeft</maml:name>
        <maml:description>
          <maml:para>Minimum combined text width, with padding before the first colored segment. Default is 0 (disabled).&#xD;
Width counts string characters, not terminal display cells; use single-line text without tabs or ANSI sequences.&#xD;
Text is never truncated. Indentation and timestamps are outside this width; log text is unchanged.&#xD;
Specify only one positive padding width per call.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">Int32</command:parameterValue>
        <dev:type>
          <maml:name>Int32</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>0</dev:defaultValue>
      </command:parameter>
      <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="False" position="14" aliases="PR">
        <maml:name>PadRight</maml:name>
        <maml:description>
          <maml:para>Minimum combined text width, with padding after the last colored segment.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">Int32</command:parameterValue>
        <dev:type>
          <maml:name>Int32</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>0</dev:defaultValue>
      </command:parameter>
      <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="False" position="named" aliases="none">
        <maml:name>ShowTime</maml:name>
        <maml:description>
          <maml:para>Switch to add time to console output. Default is not set.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">SwitchParameter</command:parameterValue>
        <dev:type>
          <maml:name>SwitchParameter</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>False</dev:defaultValue>
      </command:parameter>
      <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="False" position="6" aliases="none">
        <maml:name>StartSpaces</maml:name>
        <maml:description>
          <maml:para>Number of spaces to add before text. Default is 0.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">Int32</command:parameterValue>
        <dev:type>
          <maml:name>Int32</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>0</dev:defaultValue>
      </command:parameter>
      <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="False" position="3" aliases="Indent">
        <maml:name>StartTab</maml:name>
        <maml:description>
          <maml:para>Number of tabs to add before text. Default is 0.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">Int32</command:parameterValue>
        <dev:type>
          <maml:name>Int32</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>0</dev:defaultValue>
      </command:parameter>
      <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="0" aliases="T">
        <maml:name>Text</maml:name>
        <maml:description>
          <maml:para>Text to display on screen and write to log file if specified.&#xD;
Accepts an array of strings.</maml:para>
        </maml:description>
        <command:parameterValue required="false" variableLength="false">String[]</command:parameterValue>
        <dev:type>
          <maml:name>String[]</maml:name>
          <maml:uri />
        </dev:type>
        <dev:defaultValue>None</dev:defaultValue>
      </command:parameter>
    </command:parameters>
